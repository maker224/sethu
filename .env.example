# Sethu configuration. Copy to .env (Docker Compose reads it) or export in your
# service manager. Every value is optional; defaults are shown.

# Address the HTTP server listens on.
SETHU_BIND=0.0.0.0:8080

# Where users, devices and sessions are stored (single JSON file, mode 0600).
SETHU_DATA_DIR=./data

# Canonical public URL. Required behind a reverse proxy so browser Origin
# headers are accepted. Must include the scheme you actually serve.
# SETHU_PUBLIC_URL=https://remote.example.com

# Mark the session cookie Secure. Turn on with TLS.
# SETHU_COOKIE_SECURE=true

# Close registration after creating the owner account.
SETHU_ALLOW_REGISTRATION=true

# Session lifetime.
SETHU_SESSION_TTL_HOURS=168

# Default iPhone frame rate (1-15). Lower it on slow networks.
SETHU_IOS_FPS=10

# Default Android frame rate (1-15). adb screencap is slower than WDA.
SETHU_ANDROID_FPS=5

# Android platform-tools.
SETHU_ADB_PATH=adb
SETHU_ADB_TIMEOUT_SECONDS=10

# Trust X-Forwarded-For / X-Forwarded-Host from a local reverse proxy.
SETHU_TRUST_PROXY=false

# Extra accepted browser origins, comma separated.
# SETHU_ALLOWED_ORIGINS=http://192.168.1.10:8080

# Timeouts in seconds.
SETHU_WDA_TIMEOUT_SECONDS=6
SETHU_VNC_CONNECT_TIMEOUT_SECONDS=10

# Maximum number of simultaneous device streams.
SETHU_MAX_SESSIONS=32

# Development only: serve frontend files from disk instead of the binary.
# SETHU_WEB_DIR=./web

# Optional third-party assets, notably a vendored noVNC copy.
SETHU_VENDOR_DIR=./web/vendor

# Log filter (tracing EnvFilter syntax).
# RUST_LOG=sethu_server=debug
